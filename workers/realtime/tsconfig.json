{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["./**/*.ts", "./worker-configuration.d.ts"],
    "exclude": ["node_modules"]
}
