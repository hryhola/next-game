{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "next-game-realtime",
    "main": "./index.ts",
    "compatibility_date": "2026-03-29",
    "observability": {
        "enabled": true
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "LOBBY_ROOMS",
                "class_name": "LobbyRoomDO"
            },
            {
                "name": "GLOBAL_PRESENCE",
                "class_name": "GlobalPresenceDO"
            }
        ]
    },
    "d1_databases": [
        {
            "binding": "IDENTITY_DB",
            "database_name": "next-game-identity",
            "database_id": "6e534e11-9c93-415a-8723-f3446aa553ea",
            "migrations_dir": "./migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "ASSETS_BUCKET",
            "bucket_name": "next-game-assets"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["LobbyRoomDO"]
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["GlobalPresenceDO"]
        }
    ]
}
